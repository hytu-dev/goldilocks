{
  "name": "@hytu/goldilocks",
  "version": "0.1.2",
  "description": "TeX-quality paragraph justification as a web component",
  "keywords": ["knuth-plass", "line-breaking"],
  "license": "MIT",
  "author": "hytu <me@hytu.dev>",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/hytu-dev/goldilocks.git"
  },
  "homepage": "https://goldilocks.hytu.dev",
  "bugs": "https://github.com/hytu-dev/goldilocks/issues",

  "type": "module",
  "main": "./out/init.js",
  "types": "./out/init.d.ts",
  "exports": {
    ".": {
      "types": "./out/init.d.ts",
      "import": "./out/init.js"
    }
  },
  "files": ["out"],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "biome": "biome check .",
    "check": "tsc --noEmit",
    "build": "tsc",
    "font": "node scripts/space-font.ts",
    "test": "pnpm run build && playwright test",
    "prepublishOnly": "pnpm run build && publint && attw --pack --ignore-rules cjs-resolves-to-esm"
  },

  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.2",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.18.0"
}
